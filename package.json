{
  "name": "aismallbizguru-cflab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.jsonc --ip 127.0.0.1",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": { "hono": "4.13.8" },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.13",
    "@types/node": "22.19.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wrangler": "4.135.0"
  }
}
