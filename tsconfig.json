{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "allowImportingTsExtensions": true,
    "lib": ["ES2022"], "types": ["node"], "strict": true,
    "noUncheckedIndexedAccess": true, "noUnusedLocals": true,
    "noUnusedParameters": true, "skipLibCheck": true, "noEmit": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "worker-configuration.d.ts"]
}
