{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cflab",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "b1aa310aa0a1638d72b8b086a21e557c",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "cflab.aismallbizguru.com", "custom_domain": true },
    { "pattern": "lab.aismallbizguru.com/*", "zone_name": "aismallbizguru.com" }
  ],
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  // Secrets are Worker Secrets set outside the repository (`wrangler secret put`
  // or the dashboard), never entries here: a `vars` value is deployed in plaintext
  // and appears in the bundle. COINGECKO_DEMO_API_KEY is Bitcoin Signals'
  // CoinGecko Demo API key. It is read as env.COINGECKO_DEMO_API_KEY and sent only
  // as the x-cg-demo-api-key header. A new secret creates a new Worker version, so
  // the next gated GitHub Actions release is what reconciles it with `main`.
  "vars": {
    "PROXY_ALLOWED_HOSTS": "",
    "AUTH_FROM_EMAIL": "noreply@mail.aismallbizguru.com",
    "AUTH_FROM_NAME": "CFLab",
    "AUTH_PUBLIC_BASE_URL": "https://cflab.aismallbizguru.com",
    "AUTH_SESSION_TTL_SECONDS": "604800",
    "AUTH_RESET_TTL_SECONDS": "1800",
    "AUTH_INVITE_TTL_SECONDS": "604800"
  },
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    { "name": "RL_LOGIN", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_RECOVERY", "namespace_id": "4102", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_RESET", "namespace_id": "4103", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_ANALYTICS", "namespace_id": "4104", "simple": { "limit": 120, "period": 60 } },
    { "name": "RL_INVITE", "namespace_id": "4105", "simple": { "limit": 10, "period": 60 } }
  ],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "cflab",
    "database_id": "cb2d2eb4-2817-4581-8e50-d69212650adf",
    "migrations_dir": "migrations"
  }, {
    "binding": "ANALYTICS",
    "database_name": "cflab-analytics",
    "database_id": "54e8af8e-3345-40e7-88fd-462a688421b5",
    "migrations_dir": "migrations-analytics"
  }, {
    // Bitcoin Signals: created with explicit operator authorization on 2026-10-25.
    // This is the authoritative production resource ID; migrations run through CI.
    "binding": "BTC_SIGNALS",
    "database_name": "cflab-bitcoin-signals",
    "database_id": "7630355d-eae7-4410-aef5-7a0486ddc523",
    "migrations_dir": "migrations-bitcoin-signals"
  }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "cflab-files" }],
  // Hourly market/network collection and daily slower-adoption collection.
  "triggers": { "crons": ["7 * * * *", "41 6 * * *"] }
}
